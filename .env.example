# ── GSA CLI (required to run workers) ──────────────
# Default provider: xai (connectors.llm). Docs: docs/LLM_CONNECTOR.md
# Get a key: https://console.x.ai/
GROK_API_KEY=
# Alias also accepted:
# XAI_API_KEY=

GROK_LICENSE=GSA-DEMO-2026-LIVE
GSA_ENV=development

# ── Alternate LLM providers (optional) ─────────────
# Set connectors.llm.provider in gsa.config.json, then export matching key:
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# ── Optional CLI ───────────────────────────────────
# IVFFLAT_PROBES=10

# ── Supabase Edge Function: stripe-webhook ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOTION_TOKEN=
RESEND_API_KEY=
FROM_EMAIL=licenses@keyforagents.com
# ALERT_WEBHOOK_URL=

# ── Supabase (@supabase/server — prefer new keys) ─
# Project: knqcjedftfgmnhdgjnoo
SUPABASE_URL=https://knqcjedftfgmnhdgjnoo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://knqcjedftfgmnhdgjnoo.supabase.co/auth/v1/.well-known/jwks.json
# Legacy JWT keys (Dashboard: "Legacy anon, service_role") — avoid in new @supabase/server code:
# Prefer SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY above.
# SUPABASE_ANON_KEY=eyJ...   # role=anon
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # role=service_role — server only, never browser

# Note: live stripe-webhook Edge URL may still be on another project ref
# (havdtpnbhvufsvckgaiu). Align URL + secrets to the project you deploy to.

# Get a key: https://console.x.ai/
GROK_API_KEY=
# XAI_API_KEY=

GROK_LICENSE=GSA-DEMO-2026-LIVE
GSA_ENV=development

# Token / model routing (optional)
# GSA_MODEL=grok-4.5
# GSA_SMALL_MODEL=grok-3-mini
# GSA_BRIEF=
# GSA_SAVE=1

# Web control
# GSA_WEB_HOST=0.0.0.0
# GSA_WEB_PORT=8080

# ── Supabase project ──

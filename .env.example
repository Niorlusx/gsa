SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://knqcjedftfgmnhdgjnoo.supabase.co/auth/v1/.well-known/jwks.json

# ── Stripe webhook secrets (Edge) ──

    print(f"loading.mode={loading['mode']} memory={loading['memory']}")
    for i, w in WORKERS.items():
        print(f"{i}. {w['name']} — {w['job']}")
    print("Enter worker id (1-8) or q to quit.")
    while True:
        try:
            choice = input("> ").strip().lower()
        except EOFError:
            break
        if choice in {"q", "quit", "exit"}:
            break
        if not choice.isdigit():
            print("Enter 1-8 or q")
            continue
        wid = int(choice)
        if wid not in WORKERS:
            print("1-8 only")
            continue
        task = input("task (optional): ").strip()
        try:
            print(run_worker(wid, task, loading_override=loading_override))
        except SystemExit as e:
            print(e)
            break


def cmd_supervisor(args: list[str]) -> None:
    rest, loading_override = parse_loading_flags(args)
    print("Supervisor mode: cycling workers 1-8 (Ctrl+C to stop)")
    while True:
        for wid in WORKERS:
            try:
                out = run_worker(
                    wid,
                    f"Quick status pulse for {WORKERS[wid]['name']}",
                    loading_override=loading_override,
                )
                print(f"[{time.strftime('%H:%M:%S')}] W{wid}: {out[:200]}")
            except Exception as e:
                print(f"W{wid} error: {e}")
            time.sleep(2)
        time.sleep(30)



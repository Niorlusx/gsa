def load_config() -> dict:
    if CFG_PATH.exists():
        return json.loads(CFG_PATH.read_text(encoding="utf-8"))
    return {
        "env": os.getenv("GSA_ENV", "development"),
        "workers": list(WORKERS.keys()),
        "connectors": {
            "llm": {
                "provider": "xai",
                "api_base": "https://api.x.ai/v1",
                "model": "grok-4.5",
                "temperature": 0.4,
                "api_key_env": ["GROK_API_KEY", "XAI_API_KEY"],
            }
        },
    }


def resolve_llm(cfg: dict | None = None) -> dict[str, Any]:
    """Merge connectors.llm with presets; fall back to connectors.xai then top-level keys."""
    cfg = cfg if cfg is not None else load_config()
    connectors = cfg.get("connectors") or {}
    llm = dict(connectors.get("llm") or {})

    # Legacy connectors.xai fallback when connectors.llm is empty/missing
    if not llm and connectors.get("xai"):
        xai = dict(connectors["xai"])
        llm = {
            "provider": "xai",
            "api_base": xai.get("api_base") or xai.get("base_url") or "https://api.x.ai/v1",
            "model": xai.get("model", "grok-4.5"),
            "temperature": xai.get("temperature", 0.4),
            "api_key_env": xai.get("api_key_env") or ["GROK_API_KEY", "XAI_API_KEY"],
        }

    provider = (llm.get("provider") or "xai").lower().strip()
    preset = dict(LLM_PRESETS.get(provider) or LLM_PRESETS["xai"])

    # Top-level legacy keys (pre-1.5.0 config shape)
    if not llm.get("api_base") and cfg.get("base_url"):
        llm["api_base"] = cfg["base_url"]
    if not llm.get("model") and cfg.get("model"):
        llm["model"] = cfg["model"]
    if not llm.get("api_key_env") and cfg.get("api_key_env"):
        llm["api_key_env"] = cfg["api_key_env"]

    resolved = {
        "provider": provider if provider in LLM_PRESETS else "xai",
        "api_base": (llm.get("api_base") or preset["api_base"]).rstrip("/"),
        "model": llm.get("model") or preset["model"],
        "temperature": float(llm.get("temperature", 0.4)),
        "api_key_env": list(llm.get("api_key_env") or preset["api_key_env"]),
    }
    return resolved


def api_key(llm: dict | None = None) -> str | None:
    llm = llm or resolve_llm()
    for name in llm.get("api_key_env") or []:
        val = os.getenv(name)
        if val:
            return val
    # Last-chance common aliases for xAI
    return os.getenv("GROK_API_KEY") or os.getenv("XAI_API_KEY")


def license_ok() -> bool:
    lic = os.getenv("GROK_LICENSE", "")
    return lic in VALID_LICENSES


def memory_block() -> str:
    parts = []
    if MEMORY.exists():
        parts.append(MEMORY.read_text(encoding="utf-8")[:4000])
    if AGENTS_MD.exists():
        parts.append(AGENTS_MD.read_text(encoding="utf-8")[:2000])
    return "\n\n".join(parts)


def chat_completions(
    messages: list[dict[str, str]],
    *,
    llm: dict | None = None,
    temperature: float | None = None,
) -> str:
    """POST /chat/completions via stdlib urllib. OpenAI-compatible providers only."""
    llm = llm or resolve_llm()
    key = api_key(llm)
    if not key:
        envs = ", ".join(llm.get("api_key_env") or [])
        raise SystemExit(f"Missing API key. Set one of: {envs}")

    url = f"{llm['api_base']}/chat/completions"
    body = {
        "model": llm["model"],
        "messages": messages,
        "temperature": llm["temperature"] if temperature is None else temperature,
    }
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
            "User-Agent": f"gsa/{VERSION}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            payload = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")[:800]
        raise SystemExit(f"LLM HTTP {e.code}: {err_body}") from e
    except urllib.error.URLError as e:
        raise SystemExit(f"LLM connection error: {e.reason}") from e

    try:
        return payload["choices"][0]["message"]["content"] or ""
    except (KeyError, IndexError, TypeError) as e:
        raise SystemExit(f"Unexpected LLM response: {json.dumps(payload)[:500]}") from e


def run_worker(wid: int, task: str = "") -> str:
    if not license_ok():
        raise SystemExit("Invalid GROK_LICENSE. Use GSA-DEMO-2026-LIVE or GSA-FULL-ACCESS-2026")
    if wid not in WORKERS:
        raise SystemExit(f"Unknown worker {wid}. Use 1-8.")
    w = WORKERS[wid]
    llm = resolve_llm()
    mem = memory_block()
    system = w["system"]
    if mem:
        system += "\n\n# Project memory\n" + mem
    user = task or f"Execute your core job: {w['job']}. Give a concise actionable result."
    return chat_completions(
        [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        llm=llm,
    )



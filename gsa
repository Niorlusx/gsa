def _norm_kw(s: str) -> str:
    return re.sub(r"\s+", " ", s.strip().lower())


def analyze_keyword_gaps(
    yours: list[str],
    theirs: list[str],
    *,
    yours_label: str = "yours",
    theirs_label: str = "theirs",
) -> dict[str, Any]:
    """
    Set-diff keyword gap analysis for ASO / Apple Search Ads planning.
    Pure local logic — no network.
    """
    y_map = {_norm_kw(k): k.strip() for k in yours if k and k.strip()}
    t_map = {_norm_kw(k): k.strip() for k in theirs if k and k.strip()}
    y_set, t_set = set(y_map), set(t_map)
    only_y = sorted(y_set - t_set)
    only_t = sorted(t_set - y_set)
    shared = sorted(y_set & t_set)

    def _intent(kw: str) -> str:
        k = kw.lower()
        if any(x in k for x in ("buy", "price", "cost", "cheap", "deal")):
            return "commercial"
        if any(x in k for x in ("how", "what", "why", "best", "vs", "versus")):
            return "research"
        if any(x in k for x in ("near me", "app", "ios", "iphone")):
            return "app_discovery"
        return "generic"

    def _rows(keys: list[str], src: dict[str, str], gap: str) -> list[dict]:
        return [
            {
                "keyword": src[k],
                "normalized": k,
                "gap": gap,
                "intent": _intent(src[k]),
                "words": len(k.split()),
                "asa_hint": (
                    "exact match brand defense"
                    if gap == "shared"
                    else ("conquest / test broad" if gap == "theirs_only" else "own exact + Search Match seed")
                ),
            }
            for k in keys
        ]

    return {
        "summary": {
            "yours_count": len(y_set),
            "theirs_count": len(t_set),
            "only_yours": len(only_y),
            "only_theirs": len(only_t),
            "shared": len(shared),
            "yours_label": yours_label,
            "theirs_label": theirs_label,
        },
        "only_yours": _rows(only_y, y_map, "yours_only"),
        "only_theirs": _rows(only_t, t_map, "theirs_only"),
        "shared": _rows(shared, {**t_map, **y_map}, "shared"),
        "asa_campaign_sketch": {
            "brand_exact": [y_map[k] for k in only_y[:20]],
            "conquest_test": [t_map[k] for k in only_t[:20]],
            "category_shared": [y_map.get(k) or t_map[k] for k in shared[:20]],
            "notes": [
                "Use Apple Ads Campaign Management API v5 for live keyword reports",
                "OAuth + orgId header required — see docs/APPLE_SEARCH_ADS.md",
                "Match types: EXACT vs BROAD; Search Match for discovery",
            ],
        },
    }


def _split_kw_blob(s: str) -> list[str]:
    # comma / newline / semicolon
    parts = re.split(r"[,;\n]+", s)
    return [p.strip() for p in parts if p.strip()]



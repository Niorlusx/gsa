            }
        },
    }


def resolve_loading(
    cfg: dict | None = None,
    *,
    override: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Merge default loading + config + runtime override (CLI flags)."""
    cfg = cfg if cfg is not None else load_config()
    loading = dict(DEFAULT_LOADING)
    loading.update(cfg.get("loading") or {})
    if override:
        loading.update({k: v for k, v in override.items() if v is not None})
    mode = str(loading.get("mode") or "system").lower().strip()
    if mode not in {"system", "prepend_user", "off"}:
        mode = "system"
    loading["mode"] = mode
    loading["memory"] = bool(loading.get("memory", True))
    loading["agents_md"] = bool(loading.get("agents_md", True))
    loading["max_memory_chars"] = int(loading.get("max_memory_chars") or 2000)
    loading["max_agents_chars"] = int(loading.get("max_agents_chars") or 2000)
    loading["rag_phase"] = int(loading.get("rag_phase") or 1)
    return loading


def resolve_llm(cfg: dict | None = None) -> dict[str, Any]:
    """Merge connectors.llm with presets; fall back to connectors.xai then top-level keys."""
    cfg = cfg if cfg is not None else load_config()
    connectors = cfg.get("connectors") or {}
    llm = dict(connectors.get("llm") or {})

    # Legacy connectors.xai fallback when connectors.llm is empty/missing
    if not llm and connectors.get("xai"):
        xai = dict(connectors["xai"])
        llm = {
            "provider": "xai",
            "api_base": xai.get("api_base") or xai.get("base_url") or "https://api.x.ai/v1",
            "model": xai.get("model", "grok-4.5"),
            "temperature": xai.get("temperature", 0.4),
            "api_key_env": xai.get("api_key_env") or ["GROK_API_KEY", "XAI_API_KEY"],
        }

    provider = (llm.get("provider") or "xai").lower().strip()
    preset = dict(LLM_PRESETS.get(provider) or LLM_PRESETS["xai"])

    # Top-level legacy keys (pre-1.5.0 config shape)
    if not llm.get("api_base") and cfg.get("base_url"):
        llm["api_base"] = cfg["base_url"]
    if not llm.get("model") and cfg.get("model"):
        llm["model"] = cfg["model"]
    if not llm.get("api_key_env") and cfg.get("api_key_env"):
        llm["api_key_env"] = cfg["api_key_env"]

    resolved = {
        "provider": provider if provider in LLM_PRESETS else "xai",
        "api_base": (llm.get("api_base") or preset["api_base"]).rstrip("/"),
        "model": llm.get("model") or preset["model"],
        "temperature": float(llm.get("temperature", 0.4)),
        "api_key_env": list(llm.get("api_key_env") or preset["api_key_env"]),
    }
    return resolved


def api_key(llm: dict | None = None) -> str | None:
    llm = llm or resolve_llm()
    for name in llm.get("api_key_env") or []:
        val = os.getenv(name)
        if val:
            return val
    # Last-chance common aliases for xAI
    return os.getenv("GROK_API_KEY") or os.getenv("XAI_API_KEY")


def license_ok() -> bool:
    lic = os.getenv("GROK_LICENSE", "")
    return lic in VALID_LICENSES


def memory_block(loading: dict[str, Any] | None = None) -> str:
    """Build project context from disk according to loading options."""
    loading = loading or resolve_loading()
    if loading.get("mode") == "off":
        return ""
    parts: list[str] = []
    if loading.get("memory") and MEMORY.exists():
        cap = int(loading.get("max_memory_chars") or 2000)
        parts.append(MEMORY.read_text(encoding="utf-8")[:cap])
    if loading.get("agents_md") and AGENTS_MD.exists():
        cap = int(loading.get("max_agents_chars") or 2000)
        parts.append(AGENTS_MD.read_text(encoding="utf-8")[:cap])
    # Phase 2 hook: rag/ retrieval not selected until rag_phase >= 2
    if int(loading.get("rag_phase") or 1) >= 2:
        parts.append(
            "[rag_phase=2] Vector retrieval not wired into CLI yet — see rag/README.md"
        )
    return "\n\n".join(parts)


def parse_loading_flags(args: list[str]) -> tuple[list[str], dict[str, Any]]:
    """
    Pull loading flags from argv-like list.
    --loading system|prepend_user|off
    --no-memory / --memory
    --no-agents / --agents
    --max-memory N
    """
    out: list[str] = []
    override: dict[str, Any] = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--loading" and i + 1 < len(args):
            override["mode"] = args[i + 1]
            i += 2
            continue
        if a.startswith("--loading="):
            override["mode"] = a.split("=", 1)[1]
            i += 1
            continue
        if a in {"--no-memory", "--memory-off"}:
            override["memory"] = False
            i += 1
            continue
        if a == "--memory":
            override["memory"] = True
            i += 1
            continue
        if a in {"--no-agents", "--no-agents-md"}:
            override["agents_md"] = False
            i += 1
            continue
        if a in {"--agents", "--agents-md"}:
            override["agents_md"] = True
            i += 1
            continue
        if a == "--max-memory" and i + 1 < len(args):
            override["max_memory_chars"] = int(args[i + 1])
            i += 2
            continue
        if a == "--rag-phase" and i + 1 < len(args):
            override["rag_phase"] = int(args[i + 1])
            i += 2
            continue
        out.append(a)
        i += 1
    return out, override


def chat_completions(
    messages: list[dict[str, str]],
    *,
    llm: dict | None = None,
    temperature: float | None = None,
) -> str:
    """POST /chat/completions via stdlib urllib. OpenAI-compatible providers only."""
    llm = llm or resolve_llm()
    key = api_key(llm)
    if not key:
        envs = ", ".join(llm.get("api_key_env") or [])
        raise SystemExit(f"Missing API key. Set one of: {envs}")

    url = f"{llm['api_base']}/chat/completions"
    body = {
        "model": llm["model"],
        "messages": messages,
        "temperature": llm["temperature"] if temperature is None else temperature,
    }
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {key}",
            "User-Agent": f"gsa/{VERSION}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            payload = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")[:800]
        raise SystemExit(f"LLM HTTP {e.code}: {err_body}") from e
    except urllib.error.URLError as e:
        raise SystemExit(f"LLM connection error: {e.reason}") from e

    try:
        return payload["choices"][0]["message"]["content"] or ""
    except (KeyError, IndexError, TypeError) as e:
        raise SystemExit(f"Unexpected LLM response: {json.dumps(payload)[:500]}") from e


def run_worker(
    wid: int,
    task: str = "",
    *,
    loading_override: dict[str, Any] | None = None,
) -> str:
    if not license_ok():
        raise SystemExit("Invalid GROK_LICENSE. Use GSA-DEMO-2026-LIVE or GSA-FULL-ACCESS-2026")
    if wid not in WORKERS:
        raise SystemExit(f"Unknown worker {wid}. Use 1-8.")
    w = WORKERS[wid]
    llm = resolve_llm()
    loading = resolve_loading(override=loading_override)
    mem = memory_block(loading)
    system = w["system"]
    user = task or f"Execute your core job: {w['job']}. Give a concise actionable result."
    mode = loading.get("mode") or "system"
    if mem and mode == "system":
        system += "\n\n# Project memory\n" + mem
    elif mem and mode == "prepend_user":
        user = f"# Project memory\n{mem}\n\n# Task\n{user}"
    # mode == "off" → no injection
    return chat_completions(
        [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        llm=llm,
    )



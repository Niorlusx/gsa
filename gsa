def main() -> None:
    args = sys.argv[1:]
    if not args:
        cmd_help([])
        return
    cmd = args[0].lower()
    rest = args[1:]
    fn = COMMANDS.get(cmd)
    if not fn:
        print(f"Unknown command: {cmd}")
        cmd_help([])
        sys.exit(1)
    fn(rest)


if __name__ == "__main__":
    main()

def cmd_smoke(_: list[str]) -> None:
    errors = []
    if not CFG_PATH.exists():
        errors.append("gsa.config.json missing")
    try:
        resolve_llm()
    except Exception as e:
        errors.append(f"llm resolve failed: {e}")
    # stdlib only — no third-party import required
    if errors:
        print("SMOKE FAILED:")
        for e in errors:
            print(" -", e)
        sys.exit(1)
    print("SMOKE PASSED")
    print(f"GSA {VERSION}")
    print(f"workers={len(WORKERS)}")
    print("llm=stdlib")



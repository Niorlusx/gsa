def cmd_keywords(args: list[str]) -> None:
    """
    Competitor keyword gap analysis.

      gsa keywords --yours "ai agent,sop writer" --theirs "lindy,crewai agent"
      gsa keywords --yours-file mine.txt --theirs-file comp.txt
      gsa keywords --llm --yours ... --theirs ...   # + worker 4 narrative
    """
    rest, loading_override = parse_loading_flags(args)
    yours: list[str] = []
    theirs: list[str] = []
    use_llm = False
    yours_label, theirs_label = "yours", "theirs"
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in {"--llm", "--watch"}:
            use_llm = True
            i += 1
            continue
        if a == "--yours" and i + 1 < len(rest):
            yours.extend(_split_kw_blob(rest[i + 1]))
            i += 2
            continue
        if a == "--theirs" and i + 1 < len(rest):
            theirs.extend(_split_kw_blob(rest[i + 1]))
            i += 2
            continue
        if a == "--yours-file" and i + 1 < len(rest):
            yours.extend(_split_kw_blob(Path(rest[i + 1]).read_text(encoding="utf-8")))
            i += 2
            continue
        if a == "--theirs-file" and i + 1 < len(rest):
            theirs.extend(_split_kw_blob(Path(rest[i + 1]).read_text(encoding="utf-8")))
            i += 2
            continue
        if a == "--yours-label" and i + 1 < len(rest):
            yours_label = rest[i + 1]
            i += 2
            continue
        if a == "--theirs-label" and i + 1 < len(rest):
            theirs_label = rest[i + 1]
            i += 2
            continue
        raise SystemExit(
            "usage: gsa keywords --yours a,b --theirs c,d [--llm] "
            "[--yours-file f] [--theirs-file f] [loading flags]"
        )

    if not yours or not theirs:
        raise SystemExit("Need both --yours and --theirs keyword lists")

    report = analyze_keyword_gaps(
        yours, theirs, yours_label=yours_label, theirs_label=theirs_label
    )
    print(json.dumps(report, indent=2))

    if use_llm:
        task = (
            "Analyze this competitor keyword gap report for Apple Search Ads / ASO. "
            "Prioritize only_theirs (conquest), only_yours (defense), shared (bid wars). "
            "Output: (1) top 10 actions (2) suggested ASA ad groups (3) risks.\n\n"
            + json.dumps(report, indent=2)[:12000]
        )
        print("\n== Competitor Watcher (LLM) ==\n")
        print(run_worker(4, task, loading_override=loading_override))



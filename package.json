{
  "name": "omni-10x-hyper-agent",
  "version": "1.0.0",
  "description": "OMNI-10X Hyper-Agent - Multi-model AI orchestration with Cloudflare Workers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "setup": "node scripts/setup.js",
    "provision": "python scripts/environment_guardian.py"
  },
  "keywords": [
    "ai",
    "llm",
    "multi-model",
    "cloudflare",
    "workers",
    "orchestration"
  ],
  "author": "Niorlusx",
  "license": "MIT",
  "dependencies": {
    "wrangler": "^3.31.0",
    "stripe": "^13.10.0",
    "@openai/sdk": "^4.28.0",
    "node-fetch": "^3.3.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
